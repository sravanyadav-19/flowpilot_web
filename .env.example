# ===========================================
# FlowPilot AI - Environment Configuration
# ===========================================

# OpenAI API Key (optional - local mode works without it)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google OAuth Client ID (for Calendar sync)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Database connection (PostgreSQL)
# Leave EMPTY to use local SQLite (backend/dev.db) for development.
# Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Neon:     postgresql://<user>:<password>@ep-<name>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT secret for API sessions (generate with: openssl rand -hex 32)
JWT_SECRET=

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS Origins (comma-separated)
# - Vercel web app + local dev servers
# - Android Capacitor shell: capacitor://localhost, ionic://localhost
# - Chrome extension: chrome-extension://<your-extension-id>
ALLOWED_ORIGINS=https://flowpilot-app.vercel.app,http://localhost:3000,http://localhost:5173